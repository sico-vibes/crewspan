{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crewspan",
  "version": "0.1.0",
  "identifier": "io.github.sicovibes.crewspan",
  "build": { "frontendDist": "../splash" },
  "app": { "security": { "csp": null } },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "../stage": "stage" },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "compression": "zlib",
        "languages": ["English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCQzU3MEREQkMzRUYxODAKUldTQThUNjgzWERGTzZlMHFhck8vNjZYN01ueUJxYjdCZ0dCYmg0TVdQeDQyMisvWFpxeVJKdDgK",
      "endpoints": ["https://github.com/sico-vibes/crewspan/releases/download/desktop-updates/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
