{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-local",
  "description": "Native APIs for Crewspan's bundled splash page only.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "scope": {
        "allow": [
          { "url": "http://*" },
          { "url": "https://*" }
        ]
      }
    }
  ]
}
